name = "NekoYume517/ltcode"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/NekoYume517/ltcode"

license = "Apache-2.0"

keywords = [
  "fountain-code",
  "rateless",
  "erasure-coding",
  "luby-transform",
  "robust-soliton",
  "fec",
  "gf256",
]

preferred_target = "wasm"

description = "Rateless erasure coding in MoonBit: Luby Transform codes with robust soliton degree distribution, GF(256) symbol arithmetic, deterministic peeling decode and quantitative overhead measurement."

import {
  "moonbitlang/x@0.5.6",
}
